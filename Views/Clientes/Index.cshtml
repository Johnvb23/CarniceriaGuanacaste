@model IEnumerable<CarniceriaGuanacaste.Models.Cliente>

@{
    ViewData["Title"] = "Listado de Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Clientes</h2>
        <div>
            <a asp-action="Registrar" class="btn btn-primary">+ Registrar Nuevo Cliente</a>
            <a asp-action="Buscar" class="btn btn-outline-secondary ms-2">Buscar Cliente</a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Identificación</th>
                    <th>Tipo</th>
                    <th>Nombre Completo</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Dirección</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No hay clientes registrados en el sistema.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Identificacion</td>
                            <td>@item.TipoIdentificacion</td>
                            <td>@item.Nombre @item.PrimerApellido @item.SegundoApellido</td>
                            <td>@item.Telefono</td>
                            <td>@item.Correo</td>
                            <td>@item.Direccion</td>
                            <td class="text-center">
                                <a asp-action="Actualizar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de que desea eliminar este cliente?');">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>