@model IEnumerable<CarniceriaGuanacaste.Models.Empleado>

@{
    ViewData["Title"] = "Listado de Empleados";
}

<div class="container mt-4">
    <h2>Listado de Personas Empleadas</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Registrar" class="btn btn-primary">Registrar Nuevo Empleado</a>
        <a asp-action="Buscar" class="btn btn-secondary ms-2">Buscar Empleado</a>
    </div>

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Tipo ID</th>
                <th>Identificación</th>
                <th>Nombre Completo</th>
                <th>Área</th>
                <th>Puesto</th>
                <th>Salario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TipoIdentificacion</td>
                        <td>@item.Identificacion</td>
                        <td>@item.Nombre @item.PrimerApellido @item.SegundoApellido</td>
                        <td>@item.Area</td>
                        <td>@item.Puesto</td>
                        <td>@item.Salario.ToString("N2")</td>
                        <td>
                            <a asp-action="Actualizar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de que desea eliminar a este empleado?');">
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No hay personas empleadas registradas en el sistema.</td>
                </tr>
            }
        </tbody>
    </table>
</div>