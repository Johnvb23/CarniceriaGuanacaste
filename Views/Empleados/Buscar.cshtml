@model CarniceriaGuanacaste.Models.Empleado

@{
    ViewData["Title"] = "Buscar Empleado";
}

<div class="container mt-4">
    <h2>Buscar Persona Empleada</h2>
    <hr />

    <form asp-action="Buscar" method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <label for="identificacion" class="form-label">Número de Identificación</label>
            <input type="text" id="identificacion" name="identificacion" class="form-control" value="@Context.Request.Query["identificacion"]" placeholder="Ingrese la identificación a buscar" />
        </div>
        <div class="col-md-12 align-self-end">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Volver al Listado</a>
        </div>
    </form>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.Mensaje
        </div>
    }

    @if (Model != null)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-dark text-white">
                Resultado de la Búsqueda
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Tipo de Identificación:</dt>
                    <dd class="col-sm-9">@Model.TipoIdentificacion</dd>

                    <dt class="col-sm-3">Identificación:</dt>
                    <dd class="col-sm-9">@Model.Identificacion</dd>

                    <dt class="col-sm-3">Nombre Completo:</dt>
                    <dd class="col-sm-9">@Model.Nombre @Model.PrimerApellido @Model.SegundoApellido</dd>

                    <dt class="col-sm-3">Fecha de Nacimiento:</dt>
                    <dd class="col-sm-9">@Model.FechaNacimiento.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Fecha de Ingreso:</dt>
                    <dd class="col-sm-9">@Model.FechaIngreso.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Salario:</dt>
                    <dd class="col-sm-9">@Model.Salario.ToString("N2")</dd>

                    <dt class="col-sm-3">Área:</dt>
                    <dd class="col-sm-9">@Model.Area</dd>

                    <dt class="col-sm-3">Puesto:</dt>
                    <dd class="col-sm-9">@Model.Puesto</dd>

                    <dt class="col-sm-3">Turno:</dt>
                    <dd class="col-sm-9">@Model.Turno</dd>
                </dl>
            </div>
        </div>
    }
</div>