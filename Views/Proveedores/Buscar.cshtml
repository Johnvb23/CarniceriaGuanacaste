@model CarniceriaGuanacaste.Models.Proveedor

@{
    ViewData["Title"] = "Buscar Proveedor";
}

<div class="container mt-4">
    <h2>Buscar Proveedor</h2>
    <hr />

    <form asp-action="Buscar" method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <label for="identificacion" class="form-label">Identificación / Cédula Jurídica</label>
            <input type="text" id="identificacion" name="identificacion" class="form-control" value="@Context.Request.Query["identificacion"]" placeholder="Ingrese la identificación a buscar" />
        </div>
        <div class="col-md-12 align-self-end">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Volver al Listado</a>
        </div>
    </form>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.Mensaje
        </div>
    }

    @if (Model != null)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-dark text-white">
                Resultado de la Búsqueda
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Identificación:</dt>
                    <dd class="col-sm-9">@Model.Identificacion</dd>

                    <dt class="col-sm-3">Nombre Comercial:</dt>
                    <dd class="col-sm-9">@Model.NombreComercial</dd>

                    <dt class="col-sm-3">Contacto:</dt>
                    <dd class="col-sm-9">@Model.Contacto</dd>

                    <dt class="col-sm-3">Teléfono:</dt>
                    <dd class="col-sm-9">@Model.Telefono</dd>

                    <dt class="col-sm-3">Correo Electrónico:</dt>
                    <dd class="col-sm-9">@Model.Correo</dd>

                    <dt class="col-sm-3">Dirección:</dt>
                    <dd class="col-sm-9">@Model.Direccion</dd>
                </dl>
            </div>
        </div>
    }
</div>